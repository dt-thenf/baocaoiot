\newcommand{\FixedForm}[3]{%
 \clearpage\begingroup
 \paperwidth=#2bp\paperheight=#3bp
 \pdfpagewidth=\paperwidth\pdfpageheight=\paperheight
 \thispagestyle{empty}
 \AddToShipoutPictureBG*{\AtPageLowerLeft{\includegraphics[width=#2bp,height=#3bp]{assets/#1-nen.pdf}}}
 \AddToShipoutPictureFG*{\begin{tikzpicture}[remember picture,overlay]\input{forms/#1.tex}\end{tikzpicture}}
 \null\clearpage\endgroup
 \pdfpagewidth=\paperwidth\pdfpageheight=\paperheight}
